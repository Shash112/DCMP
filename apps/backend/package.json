{
  "name": "@dcmp/backend",
  "version": "0.1.0",
  "private": true,
  "description": "DCMP Central Backend - Modular Monolith",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test:auth": "npm run test:auth:memory",
    "test:auth:memory": "node --import tsx --test src/modules/auth/__tests__/auth-gateway.integration.spec.ts",
    "test:auth:postgres": "node --import ./src/modules/auth/__tests__/set-postgres-env.ts --import tsx --test src/modules/auth/__tests__/postgres-auth.integration.spec.ts",
    "test:auth:access": "node --import ./src/modules/auth/__tests__/set-postgres-env.ts --import tsx --test src/modules/auth/__tests__/access-token-security.integration.spec.ts",
    "test:auth:redis": "node --import ./src/modules/auth/__tests__/set-redis-postgres-env.ts --import tsx --test src/modules/auth/__tests__/phase-2.1.20-redis-http.integration.spec.ts",
    "test:auth:kms-unit": "node --import tsx --test src/modules/auth/__tests__/ecdsa-der-jose.spec.ts src/modules/auth/__tests__/auth-crypto-registration.spec.ts src/modules/auth/__tests__/multi-key-rotation.unit.spec.ts src/modules/auth/__tests__/crypto-test-hooks-and-allowlist.spec.ts",
    "test:auth:failure": "node --import ./src/modules/auth/__tests__/set-redis-postgres-env.ts --import tsx --test src/modules/auth/__tests__/phase-2.1.21-failure-recovery.integration.spec.ts",
    "test:auth:kms": "node --import ./src/modules/auth/__tests__/set-kms-redis-postgres-env.ts --import tsx --test src/modules/auth/__tests__/phase-2.1.22-live-kms.integration.spec.ts",
    "test:auth:kms:persist": "node --import ./src/modules/auth/__tests__/set-kms-redis-postgres-env.ts --import tsx --test src/modules/auth/__tests__/phase-2.1.23-persistence-rotation.integration.spec.ts",
    "test:auth:kms:multikey": "node --import ./src/modules/auth/__tests__/set-kms-multikey-env.ts --import tsx --test src/modules/auth/__tests__/phase-2.1.24-live-multikey-rotation.integration.spec.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3",
    "@aws-sdk/client-sts": "3",
    "@dcmp/api-contracts": "workspace:*",
    "@dcmp/shared-types": "workspace:*",
    "@dcmp/validation-schemas": "workspace:*",
    "@nestjs/common": "^10.3.8",
    "@nestjs/config": "^3.2.2",
    "@nestjs/core": "^10.3.8",
    "@nestjs/platform-express": "^10.3.8",
    "@nestjs/swagger": "^7.3.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "ioredis": "^6.0.0",
    "jose": "^6.2.18",
    "nestjs-pino": "^4.0.0",
    "pg": "^8.23.1",
    "pino": "^8.20.0",
    "pino-http": "^9.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/testing": "^10.3.8",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^9.0.8",
    "pino-pretty": "^11.0.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5"
  }
}
