# ==============================================================================
# DCMP - Environment Configuration Template
# Digital Checklist Management Platform
# ==============================================================================
# Copy this file to .env in local development. Never commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (apps/backend)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# PostgreSQL Container & Database Connection
POSTGRES_DB=dcmp_dev
POSTGRES_USER=dcmp_user
POSTGRES_PASSWORD=dcmp_dev_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://dcmp_user:dcmp_dev_password@localhost:5432/dcmp_dev?schema=public

# Redis Container & Background Jobs (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication (JWT)
JWT_ACCESS_SECRET=dcmp_dev_access_secret_change_in_production_min_32_chars
JWT_REFRESH_SECRET=dcmp_dev_refresh_secret_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AWS (S3 + optional KMS — use IAM role / AWS_PROFILE; never commit real secrets)
# AWS_REGION — required for AWS SDK default chain when using KMS or S3.
AWS_REGION=ap-south-1
AWS_S3_BUCKET=dcmp-evidence-dev
# AWS_PROFILE — optional locally; preferred over static keys. Omit in cloud (use IAM role).
# AWS_PROFILE=your-nonprod-profile
# Do not put real access keys here.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ------------------------------------------------------------------------------
# Auth crypto (KMS vs local)
# ------------------------------------------------------------------------------
# AUTH_CRYPTO_DRIVER — required conceptually: local | kms
#   local = TEST-ONLY (forbidden in production unless AUTH_ALLOW_LOCAL_KEYS=true lab escape)
#   kms   = production path; exclusive KMS providers (no local fallback)
AUTH_CRYPTO_DRIVER=local

# --- Required when AUTH_CRYPTO_DRIVER=kms (placeholders only; never commit real IDs in git) ---
# DCMP_KMS_REGION=ap-south-1
#   Optional override; defaults to AWS_REGION / AWS_DEFAULT_REGION.
# DCMP_KMS_ACCESS_TOKEN_KEY_ID=
#   Required in KMS mode. ECC_NIST_P256 asymmetric key for ES256 access-token Sign.
# DCMP_KMS_SSA_HMAC_KEY_ID=
#   Required in KMS mode. HMAC_256 key for SSA GenerateMac / VerifyMac.
# DCMP_KMS_REFRESH_MASTER_KEY_ID=
#   Required in KMS mode. Symmetric CMK for GenerateDataKey / Decrypt (refresh envelopes).
#   Access-token, SSA HMAC, and refresh master IDs MUST be three distinct keys.

# --- Optional verify / rotation-grace lists (comma-separated key ids or ARNs) ---
# DCMP_KMS_ACCESS_TOKEN_VERIFY_KEY_IDS=
#   Optional. Prior ECC keys whose public keys are published in JWKS and accepted for verify.
#   New tokens always sign with DCMP_KMS_ACCESS_TOKEN_KEY_ID only.
# DCMP_KMS_SSA_HMAC_VERIFY_KEY_IDS=
#   Optional. Prior HMAC keys tried after the active key during VerifyMac.
# DCMP_KMS_REFRESH_MASTER_VERIFY_KEY_IDS=
#   Optional soft allowlist for Decrypt KeyId after unwrap. CiphertextBlob already
#   embeds the wrapping CMK; GenerateDataKey always uses the active refresh master.
#   Use during CMK rotation grace. Empty list = only the active master is allowed.

# AUTH_ALLOW_LOCAL_KEYS=true
#   Lab escape only. Never set in live KMS validation or production.

AUTH_REDIS_DRIVER=memory
# AUTH_REDIS_REQUIRED=true
# AUTH_STORE_DRIVER=postgres

# Logging & Monitoring
LOG_LEVEL=debug
SENTRY_DSN=

# ------------------------------------------------------------------------------
# Customer Web Application (apps/customer-web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# Platform Admin Dashboard (apps/platform-admin)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_ADMIN_ENV=development

# ------------------------------------------------------------------------------
# Mobile Application (apps/mobile-app)
# ------------------------------------------------------------------------------
# Note: In Android Emulator, localhost is reached via 10.0.2.2
DCMP_MOBILE_API_URL=http://10.0.2.2:4000/api/v1
