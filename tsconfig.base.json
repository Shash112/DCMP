{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": false,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@dcmp/shared-types": ["packages/shared-types/src/index.ts"],
      "@dcmp/shared-types/*": ["packages/shared-types/src/*"],
      "@dcmp/api-contracts": ["packages/api-contracts/src/index.ts"],
      "@dcmp/api-contracts/*": ["packages/api-contracts/src/*"],
      "@dcmp/validation-schemas": ["packages/validation-schemas/src/index.ts"],
      "@dcmp/validation-schemas/*": ["packages/validation-schemas/src/*"],
      "@dcmp/design-tokens": ["packages/design-tokens/src/index.ts"],
      "@dcmp/design-tokens/*": ["packages/design-tokens/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next", "apps/mobile-app"]
}
