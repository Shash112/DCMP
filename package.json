{
  "name": "dcmp-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Digital Checklist Management Platform (DCMP) - Monorepo",
  "workspaces": [
    "apps/*",
    "!apps/mobile-app",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm -r --filter=!mobile-app run build",
    "lint": "pnpm -r --filter=!mobile-app run lint",
    "typecheck": "pnpm -r --filter=!mobile-app run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "dev:backend": "pnpm --filter @dcmp/backend start:dev",
    "dev:customer-web": "pnpm --filter @dcmp/customer-web dev",
    "dev:platform-admin": "pnpm --filter @dcmp/platform-admin dev",
    "dev:mobile": "cd apps/mobile-app && flutter run",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.8.0",
    "@typescript-eslint/parser": "^7.8.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.7",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
